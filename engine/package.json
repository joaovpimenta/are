{
  "name": "@are/engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Reusable ARE engine: puzzles, runtime, renderers, themes and scenarios",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./core/*": "./src/core/*.ts",
    "./input/*": "./src/input/*.ts",
    "./session/*": "./src/session/*.ts",
    "./mechanisms/*": "./src/mechanisms/*.ts",
    "./components/keypad/keypadMachine": "./src/components/keypad/keypadMachine.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "@react-three/drei": "*",
    "@react-three/fiber": "*",
    "@stylexjs/stylex": "*",
    "react": "*",
    "three": "*",
    "xstate": "*"
  }
}
